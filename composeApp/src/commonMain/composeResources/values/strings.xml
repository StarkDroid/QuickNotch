    <string name="onboarding_welcome_title">Meet QuickNotch</string>
    <string name="onboarding_welcome_subtitle">A notch that lives at the top of your screen. Here is what it can do. Everything can be fine-tuned in Settings later, and new versions install themselves.</string>
    <string name="onboarding_feature_apps">Launch your pinned apps with a click</string>
    <string name="onboarding_feature_media">See what is playing and control it</string>
    <string name="onboarding_feature_calendar">Your day at a glance, with a live event ticker</string>
    <string name="onboarding_feature_quiet">Stays out of the way until you hover</string>
    <string name="onboarding_feature_gaming">Windows only — FPS, CPU, GPU, ping and download while a fullscreen game runs; pick which show in Settings.</string>
