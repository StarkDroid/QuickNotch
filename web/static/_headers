# Cloudflare reads this file from the asset directory (build/_headers).
# Security baseline for a static prerendered site: no server, no cookies, no
# framing, top-level OAuth navigations only (no popups, no iframes).

/connect
  X-Robots-Tag: noindex, nofollow, noarchive

/connect/*
  X-Robots-Tag: noindex, nofollow, noarchive

/oauth/*
  X-Robots-Tag: noindex, nofollow, noarchive

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://accounts.google.com https://oauth2.googleapis.com https://www.googleapis.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com
